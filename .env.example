# 复制为 .env 后再改。标了「生产必须改」的值只能用于本地开发。

# 宿主机映射到 nginx 的端口。不设则是 80。
HTTP_PORT=80

# 库用户 hermit 的密码。生产必须改。
MYSQL_PASSWORD=hermit-dev-only

# 官方 MySQL 镜像启动时必填的 root 密码。生产必须改。
MYSQL_ROOT_PASSWORD=hermit-root-dev-only

# Crab 调用 /agent/ 时携带的 token，对应 hermit.reef.agent-token。生产必须改。
HERMIT_REEF_AGENT_TOKEN=dev-agent-token-change-me

# 仅当库里还没有任何管理员时，用下面两项创建第一个管理员。
# 已有管理员再次启动不会改密码。生产必须改。
HERMIT_REEF_ADMIN_USER=admin
HERMIT_REEF_ADMIN_PASSWORD=admin-dev-only

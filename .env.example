# 复制为 .env 后再改。标了「生产必须改」的值只能用于本地开发。

# 宿主机映射到 nginx 的端口。不设则是 80。
HTTP_PORT=80

# 库用户 hermit 的密码。生产必须改。
MYSQL_PASSWORD=hermit-dev-only

# 官方 MySQL 镜像启动时必填的 root 密码。生产必须改。
MYSQL_ROOT_PASSWORD=hermit-root-dev-only

# Reef 和 Crab 必须使用同一个非空令牌。Reef 用它校验 /agent/**，Crab 写入 reef.token。
# 空令牌不会启动。生产必须改。
HERMIT_REEF_AGENT_TOKEN=dev-agent-token-change-me

# 仅当库里还没有任何管理员时，用下面两项创建第一个管理员。
# 已有管理员再次启动不会改密码。生产必须改。
# Crab 的数据卷里还没有 config.yml 和 reef.pub 时，也用这两项登录 Reef 并取签名公钥。
HERMIT_REEF_ADMIN_USER=admin
HERMIT_REEF_ADMIN_PASSWORD=admin-dev-only

# Crab 控制台端口。进程只听 127.0.0.1，compose 不会把这个端口映射到其他网卡。
HERMIT_CRAB_PORT=7777

# 单独部署 Crab（docker-compose.crab.yml 或 docker run）时必填，指向 Reef 的对外地址。
# 同机 --profile client 不用写，compose 会设成 http://127.0.0.1:$HTTP_PORT。
# HERMIT_REEF_URL=http://reef.example

# 可选。不设则第一次启动在数据卷 data/instance-id 生成 UUID。必须是 UUID。
# 卷里已经有另一份实例号时不会覆盖，直接退出。
# HERMIT_CRAB_INSTANCE_ID=

# 凭证主密钥只来自环境变量或文件，不要写进镜像或 config.yml。
# HERMIT_MASTER_KEY 是 32 字节密钥的 Base64，设了就不再读文件。
# 不设时使用数据卷里的 data/master.key；没有这份文件时 Crab 会创建它。
# HERMIT_MASTER_KEY_FILE 是容器内路径，入口脚本把它复制到 data/master.key（已有且不同则退出）。
# HERMIT_MASTER_KEY=
# HERMIT_MASTER_KEY_FILE=

# 单独部署时若不想在客户端放管理员口令，把 Reef 签名公钥挂进容器并设置这项（容器内路径）。
# HERMIT_REEF_PUBLIC_KEY_FILE=
